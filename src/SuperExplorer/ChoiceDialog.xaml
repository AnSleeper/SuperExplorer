<Window x:Class="SuperExplorer.ChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="超级资源管理器" Width="440" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1" Margin="6" CornerRadius="10" Padding="16,14"
          MouseLeftButtonDown="Root_MouseDown">
    <StackPanel>
      <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="{DynamicResource FontXl}"
                 Foreground="{DynamicResource TextBrush}"/>
      <TextBlock x:Name="DetailText" TextWrapping="Wrap" FontSize="{DynamicResource FontSm}"
                 Foreground="{DynamicResource DimBrush}" Margin="0,8,0,0" Visibility="Collapsed"
                 MaxHeight="120" LineHeight="17"/>
      <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,2"/>
    </StackPanel>
  </Border>
</Window>

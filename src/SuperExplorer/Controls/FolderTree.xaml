<UserControl x:Class="SuperExplorer.Controls.FolderTree"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
  <UserControl.Resources>
    <Style x:Key="TreeTwist" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Width" Value="22"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="TreeAction" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
      <Setter Property="FontSize" Value="{DynamicResource FontSm}"/>
      <Setter Property="Width" Value="18"/>
      <Setter Property="Height" Value="18"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TreeItem" TargetType="ListBoxItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                    SnapsToDevicePixels="True">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition x:Name="FavRow" Height="150" MinHeight="52"/>
      <RowDefinition Height="5"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="常用文件夹" Margin="14,12,14,6" FontSize="{DynamicResource FontSm}"
               FontWeight="SemiBold" Foreground="{DynamicResource DimBrush}"/>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="8,0,8,8">
        <ItemsControl x:Name="FavList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="8,5"
                      Cursor="Hand" MouseLeftButtonDown="Fav_MouseDown"
                      AllowDrop="True" DragOver="Fav_DragOver" Drop="Fav_Drop"
                      ToolTip="{Binding FullPath}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FontLg}"
                             Foreground="{DynamicResource MutedBrush}"
                             TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                             VerticalAlignment="Center"/>
                  <Button Grid.Column="1" Content="✕" Style="{StaticResource TreeAction}"
                          Click="FavRemove_Click" ToolTip="取消常用"/>
                </Grid>
              </Border>
              <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                  <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Trigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="FavEmpty" Text="还没有常用文件夹。在下面树里悬停文件夹，点 ☆ 加入。"
                   Margin="6,2,6,4" FontSize="{DynamicResource FontSm}" Foreground="{DynamicResource DimBrush}"
                   TextWrapping="Wrap" LineHeight="17"/>
      </StackPanel>
    </ScrollViewer>

    <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  Background="Transparent" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                  Cursor="SizeNS" DragCompleted="FavSplitter_DragCompleted"
                  MouseDoubleClick="FavSplitter_DoubleClick" ToolTip="拖动调整常用文件夹区域高度，双击恢复默认"/>

    <StackPanel Grid.Row="3">
      <TextBlock Text="全部文件夹" Margin="14,4,14,6" FontSize="{DynamicResource FontSm}"
                 FontWeight="SemiBold" Foreground="{DynamicResource DimBrush}"/>
      <Border x:Name="RootBanner" Visibility="Collapsed" Margin="8,0,8,7" Padding="7,6"
              Background="{DynamicResource AccentSoftBrush}"
              BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="7">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="RootText" FontSize="{DynamicResource FontSm}" Foreground="{DynamicResource MutedBrush}"
                     TextWrapping="Wrap" LineHeight="15" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Content="取消隐藏" Margin="6,0,0,0"
                  Style="{StaticResource FlatButton}" Padding="6,2" FontSize="{DynamicResource FontSm}"
                  Click="Unhide_Click"/>
        </Grid>
      </Border>
    </StackPanel>

    <ListBox x:Name="TreeList" Grid.Row="4" Background="Transparent" BorderThickness="0"
             ItemContainerStyle="{StaticResource TreeItem}"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.VerticalScrollBarVisibility="Auto"
             VirtualizingPanel.IsVirtualizing="True"
             VirtualizingPanel.VirtualizationMode="Recycling"
             ScrollViewer.CanContentScroll="True"
             AllowDrop="True" DragOver="Tree_DragOver" DragLeave="Tree_DragLeave" Drop="Tree_Drop"
             MouseDoubleClick="Tree_DoubleClick" Margin="8,0,8,8">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid Height="30" Background="Transparent" Margin="{Binding Indent}">
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="2"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <Button Grid.Column="0" Content="{Binding Glyph}" Style="{StaticResource TreeTwist}"
                      Click="Twist_Click"/>

              <Path Grid.Column="1" Width="13" Height="13" Stretch="Uniform"
                    Stroke="{DynamicResource DimBrush}" StrokeThickness="1.2"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path.Style>
                  <Style TargetType="Path">
                    <Setter Property="Data" Value="M1,4 L1,2.5 L5,2.5 L6.5,4 L12,4 L12,11.5 L1,11.5 Z"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Kind}" Value="Drive">
                        <Setter Property="Data" Value="M1,4.5 L12,4.5 L12,10.5 L1,10.5 Z M3.5,7.5 L6,7.5"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Kind}" Value="Pc">
                        <Setter Property="Data" Value="M1,2.5 L12,2.5 L12,9.5 L1,9.5 Z M5,11.5 L8,11.5"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Path.Style>
              </Path>

              <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="{DynamicResource FontLg}"
                         Foreground="{DynamicResource MutedBrush}"
                         TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                         VerticalAlignment="Center" Margin="1,0,0,0"/>

              <Grid Grid.Column="3">
                <StackPanel x:Name="Acts" Orientation="Horizontal" Visibility="Collapsed">
                  <Button Content="{Binding FavoriteGlyph}" Style="{StaticResource TreeAction}"
                          Click="Fav_Click" ToolTip="加入 / 取消常用"/>
                  <Button Content="⤒" Style="{StaticResource TreeAction}"
                          Click="Top_Click" ToolTip="设为顶层（隐藏上级与同级）"/>
                  <Button Content="↗" Style="{StaticResource TreeAction}"
                          Click="Explorer_Click" ToolTip="在资源管理器中打开"/>
                </StackPanel>
              </Grid>
            </Grid>

            <ProgressBar Grid.Row="1" Height="2" Maximum="1" Value="{Binding SizeRatio}"
                         Background="Transparent" Foreground="{DynamicResource AccentBrush}"
                         BorderThickness="0" IsHitTestVisible="False"
                         Visibility="{Binding ShowBar, Converter={StaticResource BoolToVis}}"/>
          </Grid>
          <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                         Value="True">
              <Setter TargetName="Acts" Property="Visibility" Value="Visible"/>
            </DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>

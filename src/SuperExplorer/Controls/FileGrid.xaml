<UserControl x:Class="SuperExplorer.Controls.FileGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
  <ScrollViewer x:Name="Scroll"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Background="Transparent"
                Focusable="False"
                PanningMode="VerticalOnly">
    <ScrollViewer.ContextMenu>
      <ContextMenu>
        <MenuItem Header="新建文件夹" Click="MenuNewFolder_Click"/>
      </ContextMenu>
    </ScrollViewer.ContextMenu>
    <Canvas x:Name="Spacer" Height="0" Background="Transparent">
      <Canvas x:Name="Host" Width="0" Height="0"/>
      <Rectangle x:Name="Marquee" Visibility="Collapsed" IsHitTestVisible="False"
                 Fill="{DynamicResource AccentSoftBrush}"
                 Stroke="{DynamicResource AccentBrush}" StrokeThickness="1"
                 RadiusX="2" RadiusY="2"/>
    </Canvas>
  </ScrollViewer>
</UserControl>

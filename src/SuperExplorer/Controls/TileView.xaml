<UserControl x:Class="SuperExplorer.Controls.TileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
  <UserControl.ContextMenu>
    <ContextMenu>
      <MenuItem Header="打开" Click="MenuOpen_Click"/>
      <MenuItem Header="在资源管理器中显示" Click="MenuLocate_Click"/>
      <Separator/>
      <MenuItem Header="新建文件夹" Click="MenuNewFolder_Click"/>
      <MenuItem Header="重命名　F2" Click="MenuRename_Click"/>
      <Separator/>
      <MenuItem Header="移入回收站" Click="MenuDelete_Click"/>
    </ContextMenu>
  </UserControl.ContextMenu>

  <StackPanel x:Name="Root" Background="Transparent">
    <Border x:Name="Bd"
            Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}"
            Background="{DynamicResource Panel2Brush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="8" ClipToBounds="True">
      <Grid>
        <TextBlock x:Name="Placeholder" HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="{DynamicResource FontSm}" Foreground="{DynamicResource DimBrush}" Text=""/>
        <Image x:Name="Thumb" Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
        <Path x:Name="FolderIcon" Data="M2,5 L2,3 L6,3 L8,5 L14,5 L14,13 L2,13 Z"
              Fill="{DynamicResource DimBrush}" Stretch="Uniform" Width="34" Height="34"
              HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
        <TextBlock x:Name="TextPrev" Text="{Binding TextPreview}" TextWrapping="Wrap"
                   FontFamily="Consolas, Microsoft YaHei UI" FontSize="{DynamicResource FontXXs}" LineHeight="12"
                   Foreground="{DynamicResource MutedBrush}" Margin="6"
                   VerticalAlignment="Top" Visibility="Collapsed"/>
        <Border x:Name="PlayBadge" Visibility="Collapsed" HorizontalAlignment="Center"
                VerticalAlignment="Center" Width="28" Height="28" CornerRadius="14"
                Background="#8C000000" BorderBrush="#44FFFFFF" BorderThickness="1">
          <TextBlock Text="▶" FontSize="{DynamicResource FontSm}" Foreground="#FFFFFF"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"/>
        </Border>
      </Grid>
    </Border>
    <Grid Margin="1,3,1,0">
      <TextBlock x:Name="NameText" Text="{Binding Name}" FontSize="{DynamicResource FontSm}"
                 Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"
                 TextWrapping="NoWrap"/>
      <TextBox x:Name="RenameBox" Visibility="Collapsed" FontSize="{DynamicResource FontSm}"
               Background="{DynamicResource Panel2Brush}" Foreground="{DynamicResource TextBrush}"
               BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Padding="2,0"
               VerticalContentAlignment="Center"
               KeyDown="RenameBox_KeyDown" LostKeyboardFocus="RenameBox_LostFocus"/>
    </Grid>
    <TextBlock x:Name="MetaText" Text="{Binding Meta}" FontSize="{DynamicResource FontXs}" Margin="1,1,1,0"
               Foreground="{DynamicResource DimBrush}" TextTrimming="CharacterEllipsis"
               TextWrapping="NoWrap"/>
  </StackPanel>
</UserControl>

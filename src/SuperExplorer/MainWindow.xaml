<Window x:Class="SuperExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SuperExplorer.Controls"
        Title="超级资源管理器" Width="1360" Height="860"
        Icon="app.ico"
        MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Microsoft YaHei UI" FontSize="{DynamicResource FontXl}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="46"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="24"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid Margin="16,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}"/>
          <TextBlock Text="超级资源管理器" FontWeight="SemiBold" Margin="8,0,0,0"
                     VerticalAlignment="Center"/>
          <Button x:Name="GearBtn" Content="⚙" Style="{StaticResource IconButton}"
                  Margin="8,0,0,0" Click="Gear_Click" ToolTip="设置"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Border Background="{DynamicResource Panel2Brush}"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  CornerRadius="7" Padding="2">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="RowLayoutBtn" GroupName="Layout" Content="并排"
                           Style="{StaticResource SegRadio}" IsChecked="True"
                           Tag="row" Checked="Layout_Checked"/>
              <RadioButton x:Name="GridLayoutBtn" GroupName="Layout" Content="网格"
                           Style="{StaticResource SegRadio}"
                           Tag="grid" Checked="Layout_Checked"/>
            </StackPanel>
          </Border>
          <TextBlock x:Name="OpenCountText" Margin="16,0,0,0" FontSize="{DynamicResource FontMd}"
                     Foreground="{DynamicResource DimBrush}" VerticalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="TreeColumn" Width="232" MinWidth="150"/>
        <ColumnDefinition Width="5"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{DynamicResource PanelBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
        <controls:FolderTree x:Name="Tree"/>
      </Border>

      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Background="Transparent" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                    Cursor="SizeWE" DragCompleted="TreeSplitter_DragCompleted"/>

      <Grid Grid.Column="2">
        <Grid x:Name="WorkspaceHost" Margin="12"/>
        <TextBlock x:Name="EmptyHint"
                   Text="从左侧双击一个文件夹，它会在这里打开&#10;可以同时打开多个，并排或网格排列"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextAlignment="Center" FontSize="{DynamicResource FontLg}" LineHeight="24"
                   Foreground="{DynamicResource DimBrush}"/>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
      <Grid Margin="16,0">
        <TextBlock x:Name="StatusLeft" FontSize="{DynamicResource FontSm}" Foreground="{DynamicResource DimBrush}"
                   VerticalAlignment="Center"/>
        <TextBlock x:Name="StatusRight"
                   Text="拖动面板标题栏换位 · 拖分隔条调宽度 · Ctrl+Z 撤销 · Ctrl+C / Ctrl+V 复制粘贴"
                   FontSize="{DynamicResource FontSm}" Foreground="{DynamicResource DimBrush}"
                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=GearBtn}"
           Placement="Bottom" HorizontalOffset="-100" VerticalOffset="6" StaysOpen="False">
      <Border Background="{DynamicResource Panel3Brush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              CornerRadius="10" Padding="14" Width="360" Margin="0,0,0,6">
        <StackPanel>
          <TextBlock Text="设置" FontSize="{DynamicResource FontSm}" FontWeight="SemiBold"
                     Foreground="{DynamicResource DimBrush}" Margin="6,2,0,8"/>

          <TextBlock Text="配色方案" FontSize="{DynamicResource FontSm}" Foreground="{DynamicResource DimBrush}"
                     Margin="6,0,0,4"/>
          <RadioButton x:Name="ThemePink" GroupName="Theme" Tag="Pink"
                       Style="{StaticResource ThemeOption}" Checked="Theme_Checked">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="12" Height="12" Fill="#C86A96" VerticalAlignment="Center"/>
              <TextBlock Text="黑 + 暗粉" Margin="8,0,0,0"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="ThemeViolet" GroupName="Theme" Tag="Violet"
                       Style="{StaticResource ThemeOption}" Checked="Theme_Checked">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="12" Height="12" Fill="#9B7BFF" VerticalAlignment="Center"/>
              <TextBlock Text="黑 + 紫罗兰" Margin="8,0,0,0"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="ThemeCyan" GroupName="Theme" Tag="Cyan"
                       Style="{StaticResource ThemeOption}" Checked="Theme_Checked">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="12" Height="12" Fill="#6FB7C6" VerticalAlignment="Center"/>
              <TextBlock Text="黑 + 雾青" Margin="8,0,0,0"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="ThemeGreen" GroupName="Theme" Tag="Green"
                       Style="{StaticResource ThemeOption}" Checked="Theme_Checked">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="12" Height="12" Fill="#6FAE7C" VerticalAlignment="Center"/>
              <TextBlock Text="黑 + 墨绿" Margin="8,0,0,0"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="ThemeAmber" GroupName="Theme" Tag="Amber"
                       Style="{StaticResource ThemeOption}" Checked="Theme_Checked">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="12" Height="12" Fill="#D9A25E" VerticalAlignment="Center"/>
              <TextBlock Text="黑 + 暖琥珀" Margin="8,0,0,0"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="ThemeMono" GroupName="Theme" Tag="Mono"
                       Style="{StaticResource ThemeOption}" Checked="Theme_Checked">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="12" Height="12" Fill="#191919" Stroke="#8C8C8C" StrokeThickness="1"
                       VerticalAlignment="Center"/>
              <TextBlock Text="纯黑白" Margin="8,0,0,0"/>
            </StackPanel>
          </RadioButton>

          <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="4,10,4,8"/>

          <Grid Margin="6,0,6,0">
            <TextBlock Text="缩略图大小" FontSize="{DynamicResource FontLg}"
                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
            <TextBlock x:Name="SizeValueText" FontSize="{DynamicResource FontMd}"
                       Foreground="{DynamicResource AccentBrush}"
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
          <Slider x:Name="SizeSlider" Style="{StaticResource StepSlider}"
                  Margin="6,8,6,0" Minimum="100" Maximum="240"
                  TickFrequency="20" Value="140"
                  ValueChanged="SizeSlider_ValueChanged"/>
          <Canvas x:Name="SizeTicks" Height="7" Margin="6,3,6,0" ClipToBounds="False"
                  IsHitTestVisible="False"/>

          <Grid Margin="6,14,6,0">
            <TextBlock Text="界面字号" FontSize="{DynamicResource FontLg}"
                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
            <TextBlock x:Name="FontValueText" FontSize="{DynamicResource FontMd}"
                       Foreground="{DynamicResource AccentBrush}"
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
          <Slider x:Name="FontSlider" Style="{StaticResource StepSlider}"
                  Margin="6,8,6,0" Minimum="0" Maximum="7"
                  TickFrequency="1" Value="0"
                  ValueChanged="FontSlider_ValueChanged"/>
          <Canvas x:Name="FontTicks" Height="7" Margin="6,3,6,0" ClipToBounds="False"
                  IsHitTestVisible="False"/>

          <Grid Margin="6,14,6,0">
            <TextBlock Text="左侧栏宽度" FontSize="{DynamicResource FontLg}"
                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
            <TextBlock x:Name="TreeWidthValueText" FontSize="{DynamicResource FontMd}"
                       Foreground="{DynamicResource AccentBrush}"
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
          <Button x:Name="ResetTreeWidthBtn" Content="恢复默认宽度"
                  Style="{StaticResource FlatButton}" HorizontalAlignment="Left"
                  Padding="8,3" Margin="6,6,0,0" FontSize="{DynamicResource FontSm}"
                  Click="ResetTreeWidth_Click"/>

          <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="4,12,4,8"/>

          <Grid Margin="6,0,6,0">
            <StackPanel>
              <TextBlock Text="删除确认弹窗" FontSize="{DynamicResource FontLg}"
                         Foreground="{DynamicResource TextBrush}"/>
              <TextBlock Text="删除前提示文件将移入回收站" FontSize="{DynamicResource FontSm}"
                         Foreground="{DynamicResource DimBrush}" Margin="0,2,0,0"/>
            </StackPanel>
            <CheckBox x:Name="ConfirmDeleteCheck" Style="{StaticResource ToggleSwitch}"
                      HorizontalAlignment="Right" VerticalAlignment="Center"
                      Checked="ConfirmDelete_Changed" Unchecked="ConfirmDelete_Changed"/>
          </Grid>

          <TextBlock Text="撤销栈保留 50 步" FontSize="{DynamicResource FontSm}"
                     Foreground="{DynamicResource DimBrush}" Margin="6,12,0,2"/>
        </StackPanel>
      </Border>
    </Popup>

    <StackPanel x:Name="ToastLayer" Grid.RowSpan="3" VerticalAlignment="Bottom"
                HorizontalAlignment="Center" Margin="0,0,0,36" IsHitTestVisible="False"/>
  </Grid>
</Window>
